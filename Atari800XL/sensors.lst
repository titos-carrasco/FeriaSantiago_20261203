
10 GRAPHICS 0: POKE 752,1
20 POKE 710,0: POKE 709,15: POKE 712,0
30 DIM TXT$(40): DIM CMD$(100): DIM RESP$(255)
40 DIM BLANK$(26): BLANK$="                          "

100 POS. 0,0: TXT$="  ATARI 800XL | 300BPS | 8N1 | NOCTRL   ": GOSUB 1000
105 POS. 2,2: PRINT CHR$(17);: TXT$="  SENSOR DHT22  ": GOSUB 1000: PRINT CHR$(5);
110 POS. 20,2: PRINT CHR$(17);: TXT$="SENSOR MPL3115A2": GOSUB 1000: PRINT CHR$(5);
115 FOR I = 0 TO 8
120 POS. 2,I+3: PRINT CHR$(124);: POS. 19,I+3: PRINT CHR$(124);
125 POS. 20,I+3: PRINT CHR$(124);: POS. 37,I+3: PRINT CHR$(124);
130 NEXT I
135 POS. 2,12: PRINT CHR$(1);: TXT$=" SENSOR NOVA PM ": GOSUB 1000: PRINT CHR$(4);
140 POS. 20,12: PRINT CHR$(1);: FOR I=1 TO 16: PRINT CHR$(18);: NEXT I: PRINT CHR$(4);
145 FOR I = 0 TO 6
150 POS. 2,I+13: PRINT CHR$(124);: POS. 19,I+13: PRINT CHR$(124);
155 POS. 20,I+13: PRINT CHR$(124);: POS. 37,I+13: PRINT CHR$(124);
160 NEXT I
165 POS. 2,20: PRINT CHR$(1);: FOR I=1 TO 16: PRINT CHR$(18);: NEXT I:  POS. 19,20: PRINT CHR$(24);
170 POS. 20,20: PRINT CHR$(24);: FOR I=1 TO 16: PRINT CHR$(18);: NEXT I: POS. 37,20: PRINT CHR$(4);
175 POS. 2,21: PRINT CHR$(124);: POS. 37,21: PRINT CHR$(124);
180 POS. 2,22: PRINT CHR$(26);: FOR I=1 TO 34: PRINT CHR$(18);: NEXT I:  POS. 37,22: PRINT CHR$(3);

200 POS. 5,4: PRINT "TEMP:       ";
205 POS. 5,5: PRINT "HUME:       ";
210 POS. 5,6: PRINT "VOLT:       ";

215 POS. 22,4: PRINT "TEMP:        ";
220 POS. 22,5: PRINT "PRES:        ";
225 POS. 22,6: PRINT "ALTI:        ";
230 POS. 22,7: PRINT "VOLT:        ";

235 POS. 4,14: PRINT "PM2.5:        ";
240 POS. 4,15: PRINT "PM10 :        ";
245 POS. 4,16: PRINT "VOLT :        ";

250 POS. 22,14: PRINT "XXX      XXXXX";
255 POS. 22,15: PRINT " X   XX    X  ";
260 POS. 22,16: PRINT " X  X  X   X  ";
265 POS. 22,17: PRINT " X  X  X   X  ";
270 POS. 22,18: PRINT "XXX  XX    X  ";

300 CLOSE #1:CLOSE #2
305 OPEN #1,13,0,"R1:"
310 XIO 34,#1,0,0,"R1:"
315 XIO 36,#1,8,0,"R1:"
320 XIO 38,#1,32,0,"R1:"
325 XIO 40,#1,0,0,"R1:"
330 OPEN #2,4,0,"K:"

400 GOSUB 1100: CMD$="STAT": TJ=3*60: GOSUB 2100
405 IF RESP$ = "+READY" THEN GOTO 450
410 POS. 10,21: PRINT "RESPUESTA INVALIDA"
415 TJ=2*60: GOSUB 1200
420 GOTO 400

450 GOSUB 1100: CMD$="TEMP": TJ=3*60: GOSUB 2100
455 IF RESP$(1,5) <> "+TEMP" THEN GOTO 500
460 POS. 11,4: PRINT RESP$(7,12);
465 POS. 11,5: PRINT RESP$(14,19);
470 POS. 11,6: PRINT RESP$(21,26);
475 POS. 6,9: PRINT RESP$(28,37);
480 POS. 7,10: PRINT RESP$(39,46);

500 GOSUB 1100: CMD$="PRES": TJ=3*60: GOSUB 2100
505 IF RESP$(1,5) <> "+PRES" THEN GOTO 550
510 POS. 28,4: PRINT RESP$(7,13);
515 POS. 28,5: PRINT RESP$(15,21);
525 POS. 28,6: PRINT RESP$(23,29);
530 POS. 28,7: PRINT RESP$(31,37);
535 POS. 23,9: PRINT RESP$(39,48);
540 POS. 24,10: PRINT RESP$(50,57);

550 GOSUB 1100: CMD$="NOVA": TJ=3*60: GOSUB 2100
555 IF RESP$(1,5) <> "+NOVA" THEN GOTO 900
560 POS. 11,14: PRINT RESP$(7,13);
565 POS. 11,15: PRINT RESP$(15,21);
570 POS. 11,16: PRINT RESP$(23,29);
575 POS. 6,17: PRINT RESP$(31,40);
580 POS. 7,18: PRINT RESP$(42,49);

900 POS. 4,21: PRINT "     "; BLANK$;
905 TJ=10*60: GOSUB 1200
910 GOTO 400

1000 REM MUESTRA TEXTO EN REVERSO
1005 FOR X=1 TO LEN(TXT$)
1010 PRINT CHR$(128 + ASC(TXT$(X,X)));
1015 NEXT X
1020 RETURN

1100 REM REVISA EL TECLADO
1105 IF PEEK(764)=255 THEN RETURN
1110 GET #2,K
1115 IF K<>3 THEN RETURN
1120 GRAPHICS 0
1125 POKE 752,0
1130 END

1200 REM GENERA UNA PAUSA DE TJ JIFFIES
1205 POKE 18,0: POKE 19,0: POKE 20,0
1210 IF PEEK(18)*65536 + PEEK(19)*256 + PEEK(20) > TJ THEN RETURN
1215 GOSUB 1100
1220 GOTO 1210

2000 REM LEE UNA LINEA DESDE EL MODEM
2005 RESP$=""
2010 POKE 18,0: POKE 19,0: POKE 20,0
2015 STATUS #1,A
2020 IF PEEK(747) > 0 THEN GOTO 2035
2025 IF PEEK(18)*65536 + PEEK(19)*256 + PEEK(20) > TJ THEN RESP$="": RETURN
2030 GOTO 2015
2035 GET #1, B
2040 IF B=13 THEN RETURN
2045 IF B<32 OR B>124 THEN B=63
2050 RESP$(LEN(RESP$)+1) = CHR$(B)
2055 GOTO 2010

2100 REM INTERACTUA CON EL BROKER
2105 TTJJ=TJ: TJ=30
2110 GOSUB 2000: IF RESP$ <> "" THEN GOTO 2110
2115 POS. 4,21: PRINT CMD$; ": "; BLANK$;
2120 PRINT #1;CMD$;
2125 PUT#1, 13
2130 TJ=TTJJ: GOSUB 2000
2135 POS. 10,21
2140 IF LEN(RESP$) > 25 THEN PRINT RESP$(1,25);: GOTO 2150
2145 PRINT RESP$;
2150 RETURN

9999 SAVE "D1:SENSORS.BAS"
